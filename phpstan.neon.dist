# Static analysis of first-party code. Run: make phpstan (or see .github/workflows/ci.yml).
# Existing findings are recorded in phpstan-baseline.neon; new code must not add any.
includes:
    - phpstan-baseline.neon

parameters:
    level: 2
    phpVersion: 80300
    paths:
        - base.php
        - csp-report.php
        - index.php
        - fileviewer.php
        - queuescanner.php
        - classes
        - db
        - functions
        - includes
        - install
        - misc
        - modules
    excludePaths:
        analyseAndScan:
            # Vendored third-party copies inside modules
            - modules/holiday/PEAR/*
            - modules/mantis/core/*
            - modules/mantis/no.core/*
            - modules/tracIntegration/xrlib/*
            # Patched copies of dotProject 2.0.3 core files (dormant, to be redone)
            - modules/unitcost/patch_203/*
            # Not analysed: timeplanning.class.php (method signatures fatal on PHP 8, never
            # loaded), eventum's evlink (copied into an Eventum install) and groups (nested
            # copy, uses the dotProject 1.x permissions table). See the roadmap.
            - modules/eventum/evlink/*
            - modules/groups/modules/*
            - modules/timeplanning/timeplanning.class.php
            - modules/*/js/*
    bootstrapFiles:
        - phpstan-bootstrap.php
    # Libraries and themes are only read to resolve classes and functions, not analysed.
    scanDirectories:
        - lib
        - style
        - vendor
    # View files are included by index.php and use its variables ($AppUI, $m, ...),
    # so "might not be defined" fires on almost every one. Definitely undefined
    # variables are still reported.
    checkMaybeUndefinedVariables: false
    tmpDir: .phpstan-cache
    reportUnmatchedIgnoredErrors: false
